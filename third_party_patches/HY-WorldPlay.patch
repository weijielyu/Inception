+def parse_prompt_schedule(spec):
+    """[inception patch] 'CHUNK:text||CHUNK:text' -> [(chunk, text), ...]"""
+    out = []
+    for item in (spec or "").split("||"):
+        item = item.strip()
+        if not item:
+            continue
+        chunk, text = item.split(":", 1)
+        out.append((int(chunk), text.strip()))
+    return out
