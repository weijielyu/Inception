# --- text agents ---
LLM_PROVIDER=deepseek            # deepseek | anthropic
DEEPSEEK_API_KEY_FILE=~/Agentese/api_keys/deepseek.txt
DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=...          # or `ant auth login`; used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# --- vision judge (QC agent + seed-image caption) ---
VLM_PROVIDER=openrouter          # openrouter | anthropic | none
OPENROUTER_API_KEY_FILE=~/Agentese/api_keys/openrouter.txt
VLM_MODEL=google/gemini-2.5-flash

# --- film ---
FILM_BACKEND=mock                # mock | http   (http -> run `python -m inception.film_server`)
FILM_SERVER_URL=http://127.0.0.1:8765
WAN_MODEL_DIR=models/Wan-AI/Wan2.2-TI2V-5B
VIDEO_WIDTH=832
VIDEO_HEIGHT=480
VIDEO_FRAMES=81
VIDEO_FPS=16
VIDEO_STEPS=30

# --- qc / cache ---
QC_ENABLED=1
QC_MIN_SCORE=5
QC_MAX_RETRIES=1
CACHE_ENABLED=0
